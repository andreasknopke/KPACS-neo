<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <RootNamespace>KPACS.SDK.Grpc</RootNamespace>
    <AssemblyName>KPACS.SDK.Grpc</AssemblyName>
    <Description>gRPC / Protobuf contract for out-of-process K-PACS plugins. Plugins in any language implement this protocol; the host connects as a gRPC client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\plugin_service.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
