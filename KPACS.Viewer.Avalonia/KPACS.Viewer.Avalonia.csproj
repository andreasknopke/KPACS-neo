<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.8.0</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <RootNamespace>KPACS.Viewer</RootNamespace>
    <AssemblyName>KPACS.Viewer</AssemblyName>
    <Description>K-PACS DICOM Viewer - Cross-platform viewer with Avalonia UI</Description>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets\Branding\k-pacs.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="fo-dicom" Version="5.1.3" />
    <PackageReference Include="fo-dicom.Codecs" Version="5.13.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
    <PackageReference Include="OpenCL.Net" Version="2.1.0" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.7.3" />
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="11.3.7.3" />
    <!-- Diameter-Chart (Phase C1). Pinned to the last 5.1.x that targets the Avalonia 11
         line (>= 11.3.4). ScottPlot.Avalonia 5.1.59 was rejected by the compatibility
         spike: it depends on Avalonia >= 12.0.0, which conflicts with the 11.3.7 pin. -->
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.58" />
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KPACS.DCMClasses\KPACS.DCMClasses.csproj" />
    <ProjectReference Include="..\KPACS.RenderServer.Protos\KPACS.RenderServer.Protos.csproj" />
    <ProjectReference Include="..\KPACS.SDK\KPACS.SDK.csproj" />
    <ProjectReference Include="..\KPACS.SDK.Grpc\KPACS.SDK.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\AnatomyPacks\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>anatomy-packs\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Copy plugin directories into the output so they are discoverable at runtime.
       Each immediate subdirectory of Plugins/ that contains a plugin.json is a plugin. -->
  <ItemGroup>
    <Content Include="..\Plugins\**\*">
      <Link>Plugins\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Allow the unit-test assembly to reach internal types (OutlineEngine, AutoOutlineMath,
       VolumeRoiDraft, AutoOutlineSliceSource). These are internal to the viewer by design;
       the test project is the second consumer that justifies exposing them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="KPACS.Viewer.Avalonia.Tests" />
  </ItemGroup>

</Project>
